{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.ministrysprout.app/api/:path*" },
    { "source": "/platform/:path*", "destination": "https://api.ministrysprout.app/platform/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://api.ministrysprout.app/sanctum/:path*" },
    { "source": "/auth/:path*", "destination": "https://api.ministrysprout.app/auth/:path*" },
    { "source": "/login", "destination": "https://api.ministrysprout.app/login" },
    { "source": "/logout", "destination": "https://api.ministrysprout.app/logout" },
    { "source": "/forgot-password", "destination": "https://api.ministrysprout.app/forgot-password" },
    { "source": "/reset-password", "destination": "https://api.ministrysprout.app/reset-password" },
    { "source": "/email/:path*", "destination": "https://api.ministrysprout.app/email/:path*" },
    { "source": "/user/:path*", "destination": "https://api.ministrysprout.app/user/:path*" },
    { "source": "/two-factor-challenge", "destination": "https://api.ministrysprout.app/two-factor-challenge" },
    { "source": "/account/:path*", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'; worker-src 'self'" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
