{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["app/**", "bootstrap/**", "config/**", "database/**", "docker/**", "public/**", "resources/**", "routes/**", "composer.json", "composer.lock", "Dockerfile"]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/msprout-entrypoint api",
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
